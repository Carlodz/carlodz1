# RedotPay Connect configuration
# Get these from your RedotPay Connect merchant/developer dashboard.
REDOTPAY_ENV=sandbox
REDOTPAY_APP_KEY=
REDOTPAY_KEY_VERSION=1
# Put the full PEM private key here. For production, prefer a secret manager.
REDOTPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"
# Optional for sandbox. REQUIRED for production webhook signature verification.
REDOTPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_REDOTPAY_PUBLIC_KEY\n-----END PUBLIC KEY-----"
# Public HTTPS URL of this website, e.g. https://carlodz.com
PUBLIC_URL=http://localhost:5500
PORT=5500
